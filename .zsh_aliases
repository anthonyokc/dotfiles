# Working with dotfiles
# This is a function so that we can use git completion and aliases with it
dotfiles() {
  /usr/bin/git --git-dir="$HOME/dotfiles" --work-tree="$HOME" "$@"
}
compdef _git dotfiles=git # Enable git completion for dotfiles function
alias dotfiles-push='dotfiles push git@github.com:anthonyokc/dotfiles.git'
alias dotfiles-pull='dotfiles pull git@github.com:anthonyokc/dotfiles.git'
alias da='dotfiles add'
alias ds='dotfiles status'
alias dc='dotfiles commit -m'
alias dd='dotfiles diff HEAD --' # The -- prevents issues when a file is named "HEAD"
alias dp='dotfiles-push'
alias dr='dotfiles restore --staged'
alias dl='dotfiles log --oneline'
dz()
{
    local prev_dir="$(pwd)"
    cd "$HOME/dotfiles" || return 1
    lazygit --git-dir="$HOME/dotfiles" --work-tree="$HOME"
    cd "$prev_dir" || return 1
}

