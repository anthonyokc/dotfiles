alias tmux-repo='/usr/bin/git --git-dir=$HOME/tmux/ --work-tree=$HOME'

# xfce4
alias start-noshow='pgrep -x bspwm > /dev/null || (bspwm &> /dev/null &) && startxfce4 &> ~/log/xfce4.log'
alias start='pgrep -x bspwm > /dev/null || (bspwm &> /dev/null &) && startxfce4'

# wc functions
# Using cloc - now extensible function
loc()
{
    local target_dir="${1:-.}" # Default to current directory
    local vcs="${2:-git}" # Default to git
    local additional_args=("${@:3}") # Pass through any additional arguments

    cloc "$target_dir" --vcs "$vcs" "${additional_args[@]}" && echo "\n" && cloc "$target_dir" --vcs "$vcs" --percent "${additional_args[@]}" | tail -n +2
}

# Count lines in files of a certain type in a directory
linecount()
{
    local current_dir="$(pwd)"
    local file_path="${1:-$current_dir}" # Default to current directory if no first argument is provided
    local pattern="${2:-*.R}" # Default to *.R if no second argument is provided
    local sort_column="number_of_lines file -n -r" # Default sort by number of lines
    local find_args=()
    local wc_args=()

    # Process additional arguments
    for arg in "${@:3}"; do
        if [[ "$arg" == "--sort-files" ]]; then
            sort_column="file" # Sort by file name
        elif [[ "$arg" == --find-* ]]; then
            # Pass through find arguments (strip --find- prefix)
            find_args+=("${arg#--find-}")
        elif [[ "$arg" == --wc-* ]]; then
            # Pass through wc arguments (strip --wc- prefix)
            wc_args+=("${arg#--wc-}")
        else
            # Pass through any other arguments to find
            find_args+=("$arg")
        fi
    done

    nu_command="\$in | detect columns | sort-by $sort_column"

    find "$file_path" -name "$pattern" "${find_args[@]}" -print0 |
        xargs -0 wc -l "${wc_args[@]}" |
        sed "s|$file_path||" |
        column -t -N "number_of_lines,file" |
        nu --stdin --commands "$nu_command"

}

# file functions
# Count MIME types in files of a certain type in a directory
count_mimes() {
    local current_dir="$(pwd)"
    local file_path="${1:-$current_dir}" # Default to current directory if no first argument is provided
    local pattern="*.R" # Default to *.R if no second argument is provided
    local show_files=0 # Default to not showing files

    for arg in "${@:2}"; do
       if [[ "$arg" == "--show-files" ]]; then
           show_files=1
        else
           pattern="$arg"                     # anything else is the glob
        fi
    done

    if [ "$show_files" -eq 1 ]; then
      fields='1,2,3'
      column_names='count,file,mime_type,mime_encoding'
    else
      fields='2,3'
      column_names='count,mime_type,mime_encoding'
    fi

    find "$file_path" -name "$pattern" |
        xargs file --mime |
        sed 's|.*/main/||' |
        sed 's|: \+|\t|' |
        sed 's|; \+|\t|' |
        cut -f"$fields" |
        uniq -c |
        sort -r |
        column -t -N "$column_names" |
        nu --stdin --commands '$in | detect columns'
}

# Cat file and copy to clipboard
# Tries multiple clipboard methods: WSL (clip.exe), macOS (pbcopy), Linux (xclip)
cc() {
    if [ -z "$1" ]; then
        echo "Usage: cc <file>"
        return 1
    fi

    if [ ! -f "$1" ]; then
        echo "Error: File '$1' not found"
        return 1
    fi

    # Try WSL clip.exe first, then macOS pbcopy, then Linux xclip
    cat "$1" | clip.exe 2>/dev/null || pbcopy 2>/dev/null || xclip -selection clipboard 2>/dev/null || echo "Clipboard not available"
}

# ANSI 256 color table
colors() {
    for i in {0..255}; do
        printf "\033[48;5;%sm %3s \033[0m" "$i" "$i"
        if (( (i+1) % 16 == 0 )); then echo; fi
    done
}
