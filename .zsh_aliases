# File tree with plain hyphens for markdown represenation
treee() {
    tree --charset=ASCII | sed 's/|/ /g; s/`/-/g; s/+-/-/g; s/--/-/g; s/--/-/g'
}

# rm aliases
alias rm='rm -Iv' # interactive, verbose

# trash aliases
tra() {
  (( $# )) || return 0
  printf '%s\n' "$@"
  read "ans?Trash these files? [y/N] "
  echo
  [[ $ans == [Yy]* ]] && trash -- "$@"
}

# sed aliases
splitspace() {
    echo "$1" | sed 's/ /\n/g'
}
splitcomma() {
    echo "$1" | sed 's/,/\n/g'
}
splitcolon() {
    echo "$1" | sed 's/:/\n/g'
}
splitsemicolon() {
    echo "$1" | sed 's/;/\n/g'
}
splitdash() {
    echo "$1" | sed 's/-/\n/g'
}

