{
  "permissions": [
    { "action": "notion_*", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "orchestration-preflight", "effect": "deny" },
    { "action": "skill", "resource": "orchestration-astra", "effect": "deny" },
    { "action": "subagent", "resource": "sol-*", "effect": "deny" }
  ],
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "websearch": {
    "provider": "exa"
  },
  "plugins": [
    "cursor-opencode-provider@0.8.1",
    "@plannotator/opencode@latest",
    "@openchamber/opencode-claude"
  ],
  "experimental": {
    "subagent_depth": 1
  },
  "agents": {
    "build-local": {
      "description": "Private local agent for the SGLang Qwen3.8 model, with Notion access.",
      "mode": "primary",
      "model": "sglang/RadixArk/Qwen3.8-27B-NVFP4",
      "permissions": [
        { "action": "notion_*", "resource": "*", "effect": "allow" }
      ]
    }
  },
  "providers": {
    "opencode": {
      "models": {
        "kimi-k2.5": {
          "variants": [
            {
              "id": "no-thinking",
              "settings": {
                "thinking": {
                  "type": "disabled"
                }
              }
            }
          ]
        },
        "kimi-k2.6": {
          "variants": [
            {
              "id": "no-thinking",
              "settings": {
                "thinking": {
                  "type": "disabled"
                }
              }
            }
          ]
        }
      }
    },
    "lmstudio": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "LM Studio (desktop)",
      "settings": {
        "baseURL": "https://desktop.tail69958b.ts.net:1234/v1"
      },
      "models": {
        "qwen3.8-27b": {
          "name": "Qwen3.8 27B - Q4",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3.6-35b-a3b": {
          "name": "Qwen3.6 35B-A4B - Q4",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3.5-4b": {
          "name": "Qwen3.5 4B - Q4",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "qwen3.5-0.8b": {
          "name": "Qwen3.5 0.8B - Q4",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        },
        "qwopus3.5-9b-v3": {
          "name": "Qwopus3.5 9B v3",
          "capabilities": { "tools": true, "input": ["text", "image"], "output": ["text"] }
        }
      }
    },
    "rapid-mlx": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Rapid MLX",
      "settings": {
        "baseURL": "https://anthonys-macbook-pro.tail69958b.ts.net/v1"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B"
        },
        "qwen3.5-4b": {
          "name": "Qwen3.5 4B"
        }
      }
    },
    "llamacpp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "prism-ml-bonsai-8b-gguf": {
          "name": "Bonsai 8B (1-bit)"
        },
        "qwen2.5-coder-7b-instruct-gguf-g8_0": {
          "name": "Qwen2.5 Coder 7B Instruct (8-bit)"
        },
        "qwen2.5-coder-7b-instruct-q4_k_m": {
          "name": "Qwen2.5 Coder 7B Instruct (4-bit K-M)"
        }
      }
    },
    "vllm": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "vLLM (local)",
      "settings": {
        "baseURL": "https://127.0.0.1:8000/v1"
      },
      "models": {
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B"
        }
      }
    },
    "sglang": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "SGLang (local)",
      "settings": {
        "baseURL": "http://127.0.0.1:30000/v1",
        "apiKey": "EMPTY"
      },
      "models": {
        "RadixArk/Qwen3.8-27B-NVFP4": {
          "name": "Qwen3.8 27B NVFP4",
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low",
                "chat_template_kwargs": {
                  "preserve_thinking": true
                }
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium",
                "chat_template_kwargs": {
                  "preserve_thinking": true
                }
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh",
                "chat_template_kwargs": {
                  "preserve_thinking": true
                }
              }
            },
            {
              "id": "none",
              "settings": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            }
          ],
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 53000,
            "output": 4096
          },
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": false
      },
      "r-btw-readonly": {
        "type": "local",
        "command": [
          "Rscript",
          "-e",
          "btw::btw_mcp_server(tools = btw::btw_tools(c('docs', 'pkg', 'env', 'sessioninfo')))"
        ],
        "disabled": true
      },
      "r-btw-run": {
        "type": "local",
        "command": [
          "Rscript",
          "-e",
          "options(btw.run_r.enabled = TRUE); btw::btw_mcp_server(tools = btw::btw_tools(c('env', 'run', 'docs', 'pkg', 'sessioninfo')))"
        ],
        "disabled": false
      }
    }
  }
}
