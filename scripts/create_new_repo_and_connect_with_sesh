#!/bin/bash
set -euo pipefail

source "$HOME/scripts/helpers/run_with_exit_prompt.sh"
source "$HOME/scripts/helpers/ensure_ssh_key_loaded.sh"
source "$HOME/scripts/helpers/connect_multiplexer_workspace.sh"

usage() {
  cat <<'EOF'
create_new_repo_and_connect_with_sesh: create a new GitHub (or local-only) repo and connect with sesh.

Usage:
  create_new_repo_and_connect_with_sesh [flags]

Flags:
  --owner <owner>        GitHub username or organization (default: authenticated gh user)
  --name <name>          Repository name (required with --non-interactive)
  --layout <bare|normal> Repo layout (bare = bare repo + worktrees)
  --private              Create a private GitHub repo
  --public               Create a public GitHub repo
  --template <o/r|none>  GitHub template repo to create from
  --local-only           Only create the repository locally (no GitHub remote)
  --no-connect           Skip multiplexer connection at the end (prints the path)
  --non-interactive      Never prompt. Requires --name. Defaults: bare layout,
                         private, no template, no browser, implies --no-connect.
  -h, --help             Show this help.

Any value not supplied by a flag is prompted for interactively with gum,
unless --non-interactive is set.
EOF
}

function create_new_repo_and_connect_with_sesh() {
  local owner="" repo_name="" layout="" visibility="" template=""
  local local_only=false local_only_set=false
  local non_interactive=false no_connect=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --owner) owner="$2"; shift 2 ;;
      --owner=*) owner="${1#*=}"; shift ;;
      --name) repo_name="$2"; shift 2 ;;
      --name=*) repo_name="${1#*=}"; shift ;;
      --layout) layout="$2"; shift 2 ;;
      --layout=*) layout="${1#*=}"; shift ;;
      --private) visibility="private"; shift ;;
      --public) visibility="public"; shift ;;
      --template) template="$2"; shift 2 ;;
      --template=*) template="${1#*=}"; shift ;;
      --local-only) local_only=true; local_only_set=true; shift ;;
      --no-connect) no_connect=true; shift ;;
      --non-interactive) non_interactive=true; no_connect=true; shift ;;
      -h | --help) usage; return 0 ;;
      *)
        printf 'Unknown argument: %s\n\n' "$1" >&2
        usage >&2
        return 1
        ;;
    esac
  done

  if [[ -n "$layout" && "$layout" != "bare" && "$layout" != "normal" ]]; then
    printf -- '--layout must be "bare" or "normal", got: %s\n' "$layout" >&2
    return 1
  fi

  if [[ "$non_interactive" == true ]]; then
    if [[ -z "$repo_name" ]]; then
      printf -- '--non-interactive requires --name.\n' >&2
      return 1
    fi
    layout="${layout:-bare}"
    visibility="${visibility:-private}"
    template="${template:-none}"
    local_only_set=true
  fi

  # Normalize template: "none"/"None"/empty flag value all mean no template.
  if [[ "${template,,}" == "none" ]]; then
    template="None"
  fi

  # Resolve the owner (GitHub username or org).
  if [[ -z "$owner" ]]; then
    if [[ "$non_interactive" == true ]]; then
      owner="$(gh api user --jq '.login')"
    else
      local GITHUB_USERNAME
      GITHUB_USERNAME="$(run_with_exit_prompt "Fetching GitHub profile…" gh api user --jq '.login')"
      local github_users=("$GITHUB_USERNAME")
      if [[ -n "${GITHUB_ORG:-}" ]]; then
        github_users+=("$GITHUB_ORG")
      fi
      github_users=("${github_users[@],,}") # Convert array elements to lowercase

      owner="$(
        printf "%s\n" "${github_users[@]}" |
          gum filter \
            --placeholder 'Pick a GitHub username or organization...' \
            --limit 1 --height 50 --prompt='👤 '
      )"
    fi
  fi
  owner="${owner,,}"

  if [[ -z "$owner" ]]; then
    printf 'No GitHub owner selected. Exiting.\n' >&2
    return 1
  fi

  local github_user_dir="$HOME/code/$owner"

  if [[ -z "$repo_name" ]]; then
    repo_name="$(gum input --placeholder "What's the name of the new repo?" --prompt="📝 ")"
  fi

  if [[ -z "$repo_name" ]]; then
    if [[ "$non_interactive" == true ]]; then
      printf 'No repo name provided. Exiting.\n' >&2
    else
      gum spin --title "No repo name provided. Exiting..." -- sleep 2
    fi
    return 1
  fi

  if [[ -d "$github_user_dir/$repo_name" ]]; then
    if [[ "$no_connect" == true ]]; then
      printf 'Directory %s already exists.\n' "$github_user_dir/$repo_name" >&2
      return 1
    fi
    printf 'Directory %s already exists. Connecting...\n' "$github_user_dir/$repo_name"
    connect_multiplexer_workspace "$github_user_dir/$repo_name"
    return 0
  fi

  # Allow repository setup to happen locally before creating its GitHub remote.
  if [[ "$local_only_set" == false ]]; then
    if gum confirm "Create this repository locally only for now?"; then
      local_only=true
    fi
  fi

  if [[ -z "$layout" ]]; then
    local repo_layouts=("Bare Git Repo" "Normal Git Repo")
    local repo_layout
    repo_layout=$(
      printf "%s\n" "${repo_layouts[@]}" |
        gum filter --limit 1 --placeholder "Choose a repo type" --height 50
    )
    case "$repo_layout" in
      "Bare Git Repo") layout="bare" ;;
      "Normal Git Repo") layout="normal" ;;
      *)
        printf "No repository type selected. Exiting.\n"
        return 1
        ;;
    esac
  fi

  mkdir -p "$github_user_dir" # Create directory for the username if it doesn't exist

  if [[ "$local_only" == true ]]; then
    local repo_root="$github_user_dir/$repo_name"
    local connect_dir

    # Initialize either a standard repository or a bare repository with a main worktree.
    if [[ "$layout" == "normal" ]]; then
      git init --initial-branch=main "$repo_root"
      connect_dir="$repo_root"
    else
      mkdir "$repo_root"
      git init --bare --initial-branch=main "$repo_root/.git"
      git -C "$repo_root" config core.logallrefupdates true
      git -C "$repo_root" worktree add --orphan "$repo_root/main"
      connect_dir="$repo_root/main"
    fi

    printf "Created local repository at %s.\n" "$repo_root"
    printf "Run create_github_repo_from_local_and_push from the repository when you are ready to publish it.\n"
    if [[ "$no_connect" == true ]]; then
      printf 'Repository ready at %s\n' "$connect_dir"
    else
      connect_multiplexer_workspace "$connect_dir"
    fi
    return
  fi

  # GitHub path from here on.
  ensure_github_ssh_key_loaded

  # Get templates and add a "None" option
  if [[ -z "$template" ]]; then
    template=$(
      (
        echo "None"
        printf '%s\0' openjusticeok anthonyokc |
          xargs -I{} -0 -n1 -P2 gh repo list {} \
            --topic template --json nameWithOwner \
            --jq '.[].nameWithOwner' |
          sort -u
      ) |
        gum filter --limit 1 \
          --placeholder 'Pick a repo template or None' \
          --height 50 --prompt '📚 '
    )
    if [[ -z "$template" ]]; then
      printf 'No template selected. Exiting.\n' >&2
      return 1
    fi
  fi

  if [[ -z "$visibility" ]]; then
    local repo_types=("🌐 Public" "🔒 Private")
    local repo_type
    repo_type=$(
      printf "%s\n" "${repo_types[@]}" |
        gum filter --limit 1 --placeholder 'Pick repo type...' --height 50
    )
    case "$repo_type" in
      "🌐 Public") visibility="public" ;;
      "🔒 Private") visibility="private" ;;
      *)
        printf 'No repository visibility selected. Exiting.\n' >&2
        return 1
        ;;
    esac
  fi

  # Create repo with or without template based on selection
  local create_args=("$owner/$repo_name" "--$visibility")
  if [[ "$template" != "None" ]]; then
    create_args+=(--template "$template")
  fi
  gh repo create "${create_args[@]}"

  # Open the repository URL in the default web browser
  if [[ "$non_interactive" == false ]]; then
    if ! gh repo view "$owner/$repo_name" --web 2>/dev/null; then
      printf "⚠️  Failed to open repo in browser (gh repo view --web). Continuing...\n"
    fi
  fi

  local clone_dir="$github_user_dir/$repo_name"

  if [[ "$layout" == "normal" ]]; then
    if [[ "$non_interactive" == true ]]; then
      git clone "git@github.com:$owner/$repo_name.git" "$clone_dir"
    else
      gum spin --title "Cloning from GitHub into $clone_dir" -- \
        git clone "git@github.com:$owner/$repo_name.git" "$clone_dir"
    fi
    printf "Done! 🎉\n"
    if [[ "$no_connect" == true ]]; then
      printf 'Repository ready at %s\n' "$clone_dir"
    else
      printf "💻 Multiplexer connecting to $clone_dir..."
      connect_multiplexer_workspace "$clone_dir"
    fi
  else # Bare Git Repo
    if [[ "$non_interactive" == true ]]; then
      git-clone-bare-for-worktrees.sh "git@github.com:$owner/$repo_name.git" "$clone_dir"
    else
      gum spin --title "Cloning from GitHub into $clone_dir" -- \
        git-clone-bare-for-worktrees.sh "git@github.com:$owner/$repo_name.git" "$clone_dir"
    fi
    printf "Done! 🎉\n"

    # Check which branch exists (main or master) and connect to it
    local repo_root="$clone_dir"
    local connect_dir=""
    if [[ -d "$repo_root/main" ]]; then
      connect_dir="$repo_root/main"
    elif [[ -d "$repo_root/master" ]]; then
      connect_dir="$repo_root/master"
    else
      # If neither main nor master exists, connect to the first worktree
      local worktree_dir
      worktree_dir="$(git -C "$repo_root" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -n 1)"
      if [[ -n "$worktree_dir" && "$worktree_dir" == "$repo_root" ]]; then
        if [[ "$(git -C "$repo_root" rev-parse --is-bare-repository)" == "true" ]]; then
          worktree_dir=""
        fi
      fi

      if [[ -n "$worktree_dir" ]]; then
        connect_dir="$worktree_dir"
      else
        # No worktrees exist, create one from main/master/first branch
        printf "🌱 No branch directories found, creating worktree..."
        local target_branch=""
        if git -C "$repo_root" show-ref --verify --quiet refs/heads/main; then
          target_branch="main"
        elif git -C "$repo_root" show-ref --verify --quiet refs/heads/master; then
          target_branch="master"
        else
          target_branch="$(git -C "$repo_root" for-each-ref --format='%(refname:short)' refs/heads | head -n 1)"
        fi

        if [[ -z "$target_branch" ]]; then
          printf "❌ No branches found to create a worktree."
          return 1
        fi

        git -C "$repo_root" worktree add "$target_branch" "$target_branch"
        connect_dir="$repo_root/$target_branch"
      fi
    fi

    if [[ "$no_connect" == true ]]; then
      printf 'Repository ready at %s\n' "$connect_dir"
    else
      printf "💻 Multiplexer connecting to $connect_dir..."
      connect_multiplexer_workspace "$connect_dir"
    fi
  fi
}

create_new_repo_and_connect_with_sesh "$@"
