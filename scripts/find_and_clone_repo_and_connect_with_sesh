#!/usr/bin/env bash
# find_and_clone_repo_and_connect_with_sesh - Clone a GitHub repository using fzf and gum, then connect with sesh
set -euo pipefail

source "$HOME/scripts/helpers/run_with_exit_prompt.sh"
source "$HOME/scripts/helpers/ensure_ssh_key_loaded.sh"

# fzf fuzzy search of git repositories, then clone
function find_and_clone_repo_and_connect_with_sesh() {
    ensure_github_ssh_key_loaded

    # Start GitHub API search in background
    temp_fresh_results=$(mktemp)
    # Ensure temp file is removed on exit
    {
        $HOME/scripts/listrepo_gql $GITHUB_SEARCH_OAUTH_TOKEN $GITHUB_ORG > "$temp_fresh_results" 2>/dev/null &
    }
    # Capture background process ID to manage it later
    api_pid=$!

    # Show immediate options (Other + cached repos) without waiting for API
    immediate_options=$(
        (
            echo "Other"
            echo "🔄 Search fresh repos..."
            cat $fzf_git_cache 2>/dev/null
        ) | nauniq
    )

    # Let user select from immediate options
    selection="$(
        echo "$immediate_options" | \
        gum filter --limit 1 --placeholder 'Clone a repo...' --height 50 --prompt='🤖 ' --header="GitHub Repo Clone Tool" --header.foreground 5
    )"

    # If user selected "Search fresh repos", wait for API and show full results
    if [[ "$selection" == "🔄 Search fresh repos..." ]]; then
        # Wait for background API call to complete
        run_with_exit_prompt "Searching for GitHub Repos..." \
          wait $api_pid;

        selection="$( \
            (
              echo "Other";
              cat $fzf_git_cache 2>/dev/null;
              cat "$temp_fresh_results" 2>/dev/null
            ) | \
            tee $fzf_git_cache | \
            nauniq | \
            gum filter --limit 1 --placeholder 'Clone a repo...' --height 50 --prompt='🤖 ' --header="GitHub Repo Clone Tool" --header.foreground 5

        )"
    else
        # Clean up background process if user didn't wait for it
        kill $api_pid 2>/dev/null
    fi

    # Clean up temp file
    rm -f "$temp_fresh_results"

    # If no selection made, exit
    if [[ -z $selection ]]; then
        return
    fi

    # If user selected nothing, exit

    if [[ -z $selection ]]; then
        return
    fi

    if [[ "$selection" == "Other" ]]; then
        repo="$(gum input --placeholder 'user/repo' --prompt 'Enter GitHub repo (user/repo): ')"
        repo="${repo## }"; repo="${repo%% }"
        if [[ -z "$repo" || "$repo" != */* || "$repo" == *" "* || "$repo" == */ || "$repo" == /* ]]; then
            gum style --foreground 1 "Invalid format. Expected: user/repo (e.g., jalvesaq/nvimcom)."
            return 1
        fi
    else
        repo="$selection"
    fi

    username="${repo%%/*}"  # Extracts the username part before '/'
    repo_dir="$HOME/code/$repo"

    if [ -d "$repo_dir" ]; then
       gum spin --title "Directory $repo_dir already exists. Connecting..." -- \
           sesh connect "$repo_dir"
    else
       mkdir -p "$HOME/code/$username"  # Create directory for the username if it doesn't exist

       # Add gum select to choose between Normal Git Repo and Bare Git Repo
       repo_types=("Bare Git Repo" "Normal Git Repo")
       repo_type=$( \
           printf "%s\n" "${repo_types[@]}" | \
           gum filter --limit 1 --placeholder "Choose a repo type" --height 50
       )

       if [[ $repo_type == "Normal Git Repo" ]]; then
           run_with_exit_prompt "Cloning from GitHub into $repo_dir" \
               git clone "git@github.com:$repo.git" "$repo_dir"

           # Connect with sesh
           sesh connect "$repo_dir"
       else
           run_with_exit_prompt "Cloning from GitHub into $repo_dir" \
               git-clone-bare-for-worktrees.sh "git@github.com:$repo.git" "$repo_dir"

            # Check which branch exists (main or master) and connect to it
            repo_root="$repo_dir"
            if [[ -d "$repo_root/main" ]]; then
              printf "💻 Sesh connecting to $repo_root/main..."
              sesh connect "$repo_root/main"
            elif [[ -d "$repo_root/master" ]]; then
              printf "💻 Sesh connecting to $repo_root/master..."
              sesh connect "$repo_root/master"
            else
              # If neither main nor master exists, connect to the first worktree
              worktree_dir="$(git -C "$repo_root" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' | head -n 1)"
              if [[ -n "$worktree_dir" && "$worktree_dir" == "$repo_root" ]]; then
                if [[ "$(git -C "$repo_root" rev-parse --is-bare-repository)" == "true" ]]; then
                  worktree_dir=""
                fi
              fi
              if [[ -n "$worktree_dir" ]]; then
                printf "💻 Sesh connecting to $worktree_dir..."
                sesh connect "$worktree_dir"
              else
                # No worktrees exist, create one from main/master/first branch
                printf "🌱 No branch directories found, creating worktree..."
                target_branch=""
                if git -C "$repo_root" show-ref --verify --quiet refs/heads/main; then
                  target_branch="main"
                elif git -C "$repo_root" show-ref --verify --quiet refs/heads/master; then
                  target_branch="master"
                else
                  target_branch="$(git -C "$repo_root" for-each-ref --format='%(refname:short)' refs/heads | head -n 1)"
                fi

                if [[ -z "$target_branch" ]]; then
                  printf "❌ No branches found to create a worktree."
                  return 1
                fi

                git -C "$repo_root" worktree add "$target_branch" "$target_branch"
                printf "💻 Sesh connecting to $repo_root/$target_branch..."
                sesh connect "$repo_root/$target_branch"
              fi
            fi
       fi
    fi
}

find_and_clone_repo_and_connect_with_sesh
