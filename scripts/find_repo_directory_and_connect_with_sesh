#!/usr/bin/env bash
# Search and connect to tmux/sesh sessions or Herdr workspaces and code repos.
set -euo pipefail

source "$HOME/scripts/helpers/connect_multiplexer_workspace.sh"

pause_on_error() {
  local status=$?

  trap - EXIT
  if ((status != 0)) && [[ -r /dev/tty ]]; then
    printf '\nCommand failed with status %d. Press Enter to close.' "$status" >/dev/tty
    IFS= read -r </dev/tty || true
  fi

  exit "$status"
}

trap pause_on_error EXIT

# List all existing sesh sessions
list_sesh() {
  sesh list -i -t -c
}

# Find all code directories under ~/code, accounting for multiple Git worktrees
list_code_repos() {
  fd -td . ~/code --min-depth 2 --max-depth 2 |
    xargs -n1 -P"$(nproc)" bash -c '
      dir="${1%/}";
      if [ "$(git -C "$dir" rev-parse --is-bare-repository 2>/dev/null)" = true ]; then
        for wt in "$dir"/*; do
          printf "%s\n" "$wt"
        done
      else
        printf "%s\n" "$dir"
      fi
    ' _
}

# Convert directory paths to icon-based labels while preserving their paths,
# then sort by:
#   1) Repository name
#   2) main/master branches first (flag=0), everything else (flag=1)
#   3) Branch name
format_and_sort() {
  awk 'BEGIN { OFS="\t" }
         {
           # Keep the real path in a hidden TSV column so the picker can show a
           # concise label without losing the value sesh needs to create a session.
           path = $0
           original = $0
           sub("^" ENVIRON["HOME"] "/code/[^/]+/", " ", original)

           # Original line might look like: " reponame/branch"
           sub(/^ /, "", original)
           split(original, parts, "/")

           # parts[1] = repo name, parts[2] = branch name (if any)
           repo   = parts[1]
           branch = (length(parts) > 1 ? parts[2] : "")

           # If no branch name, treat it as "main" for sorting
           flag = (branch == "main" || branch == "master" || branch == "") ? 0 : 1

           # We store: [repo] [flag] [branch] [display label] [absolute path]
           print repo, flag, branch, " " original, path
         }' |
    sort -t $'\t' -k1,1 -k2,2n -k3,3 |
    cut -f4- # Output the display label and absolute path (tab separated)
}

# Build the formatted repo list so we can wrap it in a cancellable spinner
build_repo_list() {
  list_code_repos | format_and_sort
}

main_tmux() {
  local repo_list selected_sesh selected_path

  # Take one snapshot so the labels shown by gum and their paths stay in sync.
  repo_list="$(build_repo_list)"

  if ! selected_sesh=$(
    {
      list_sesh
      if [[ -n "$repo_list" ]]; then
        # Gum only receives the first TSV column, keeping absolute paths hidden.
        printf '%s\n' "$repo_list" | cut -f1
      fi
    } | gum filter --limit 1 --placeholder 'Pick a session' --height 50 --width 40 \
      --prompt='🔎 ' --header="Sesh Selector" --header.foreground 3
  ); then
    return 0
  fi

  [[ -z "$selected_sesh" ]] && return

  # The custom folder icon identifies entries discovered under ~/code rather
  # than entries already known to sesh.
  if [[ "$selected_sesh" == " "* ]]; then
    # Recover the exact path paired with the selected display label.
    selected_path=$(
      printf '%s\n' "$repo_list" |
        awk -F '\t' -v selected="$selected_sesh" '$1 == selected { print $2; exit }'
    )

    if [[ -z "$selected_path" ]]; then
      printf "Error: Could not resolve repository path for '%s'.\n" "$selected_sesh" >&2
      return 1
    fi

    # Passing the path lets sesh create an untracked session and add it to zoxide.
    sesh connect "$selected_path"
  else
    sesh connect "$selected_sesh"
  fi
}

main_herdr() {
  local workspace_rows config_rows repo_rows candidates selection selected_row
  local selected_type selected_target selected_label

  workspace_rows="$(
    herdr workspace list |
      jq -r '.result.workspaces[] | ["● " + .label, "workspace", .workspace_id, .label] | @tsv'
  )"
  config_rows="$(
    sesh list -c -j |
      jq -r '.[] | ["⚙ " + .Name, "config", .Path, .Name] | @tsv'
  )"
  repo_rows="$(
    build_repo_list |
      awk -F '\t' 'NF >= 2 { print $1 "\trepo\t" $2 "\t" substr($1, 3) }'
  )"

  candidates="$(printf '%s\n%s\n%s\n' "$workspace_rows" "$config_rows" "$repo_rows" | awk 'NF')"
  if ! selection="$(
    printf '%s\n' "$candidates" | cut -f1 |
      gum filter --limit 1 --placeholder 'Pick a workspace' --height 50 --width 50 \
        --prompt='🔎 ' --header='Herdr Workspace Selector' --header.foreground 3
  )"; then
    return 0
  fi
  [[ -z "$selection" ]] && return

  selected_row="$(
    printf '%s\n' "$candidates" |
      awk -F '\t' -v selected="$selection" '$1 == selected { print; exit }'
  )"
  IFS=$'\t' read -r _ selected_type selected_target selected_label <<<"$selected_row"

  case "$selected_type" in
    workspace) herdr workspace focus "$selected_target" >/dev/null ;;
    config) connect_multiplexer_workspace "$selected_target" "$selected_label" label ;;
    repo) connect_multiplexer_workspace "$selected_target" "$selected_label" path ;;
  esac
}

if [[ "${MULTIPLEXER:-}" == "herdr" || -n "${HERDR_SOCKET_PATH:-}" ]]; then
  main_herdr "$@"
else
  main_tmux "$@"
fi
