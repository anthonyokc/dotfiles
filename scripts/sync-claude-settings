#!/usr/bin/env python3
"""Apply portable Claude settings without replacing host-specific settings.

Run after pulling dotfiles. Local skills and existing skill symlinks stay intact.
The four manual-only skills keep their frontmatter in the separate skills repo.
"""

import json
from pathlib import Path


def main():
    home = Path.home()
    source = home / ".config/claude/settings.shared.json"
    target = home / ".claude/settings.json"
    shared = json.loads(source.read_text())
    current = json.loads(target.read_text()) if target.exists() else {}
    if not isinstance(shared, dict) or not isinstance(current, dict):
        raise SystemExit("Claude settings must be JSON objects; nothing changed.")
    merged = {**current, **shared}
    if merged == current:
        print(f"Already synced: {target}")
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(json.dumps(merged, indent=2) + "\n")
    print(f"Synced: {target}")


if __name__ == "__main__":
    main()
