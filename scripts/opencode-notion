#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == "--exa" ]]; then
  shift
  export OPENCODE_CONFIG_CONTENT='{"permissions":[{"action":"notion_*","resource":"*","effect":"allow"},{"action":"websearch","resource":"*","effect":"ask"},{"action":"webfetch","resource":"*","effect":"ask"}]}'
else
  export OPENCODE_CONFIG_CONTENT='{"permissions":[{"action":"notion_*","resource":"*","effect":"allow"}]}'
fi

exec opencode "$@"
