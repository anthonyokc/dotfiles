#!/bin/bash
# find_and_clone_repo: Clone a GitHub repository using fzf and gum
# TODO: Why does this script exist?
set -euo pipefail

# Pull reusable spinners/exit helpers
source "$HOME/scripts/helpers/run_with_exit_prompt.sh"
source "$HOME/scripts/helpers/ensure_ssh_key_loaded.sh"

function normalize_github_repo_input() {
    local input="$1"
    local repo

    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"
    input="${input%%\#*}"
    input="${input%%\?*}"
    input="${input%/}"

    if [[ "$input" =~ ^https?://github\.com/([^/]+)/([^/]+)(/.*)?$ ]]; then
        repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    elif [[ "$input" =~ ^github\.com/([^/]+)/([^/]+)(/.*)?$ ]]; then
        repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    elif [[ "$input" =~ ^git@github\.com:([^/]+)/([^/]+)$ ]]; then
        repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    elif [[ "$input" =~ ^ssh://git@github\.com/([^/]+)/([^/]+)$ ]]; then
        repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
    else
        repo="$input"
    fi

    repo="${repo%.git}"

    if [[ -z "$repo" || "$repo" != */* || "$repo" == *" "* || "$repo" == */ || "$repo" == /* ]]; then
        return 1
    fi

    printf '%s\n' "$repo"
}

# fzf fuzzy search of git repositories, then clone
function find_and_clone_repo() {
    ensure_github_ssh_key_loaded

    selection="$(
        (
            echo "Other"
            cat "$fzf_git_cache" 2>/dev/null
            run_with_exit_prompt "Searching for GitHub Repos..." \
                "$HOME/scripts/listrepo_gql" "$GITHUB_SEARCH_OAUTH_TOKEN" "$GITHUB_ORG"
        ) | \
        tee "$fzf_git_cache" | \
        nauniq | \
        gum filter --limit 1 --placeholder 'Clone a repo' --height 50 --prompt='⬇️ ' --header="GitHub Repo Clone Tool" --header.foreground 5
    )"

    if [[ -z $selection ]]; then
        return
    fi

    if [[ "$selection" == "Other" ]]; then
        repo="$(gum input --placeholder 'user/repo' --prompt 'Enter GitHub repo (user/repo): ')"
        if ! repo="$(normalize_github_repo_input "$repo")"; then
            gum style --foreground 1 "Invalid format. Expected: user/repo or a GitHub URL (e.g., jalvesaq/nvimcom)."
            return 1
        fi
    else
        repo="$selection"
    fi

    echo "Cloning '$repo' from Github"
    git clone "git@github.com:$repo.git" "$HOME/code/$repo"
}

find_and_clone_repo
